# NOTE: git treats "#" as a comment only at the START of a line. Never put a
# comment after a pattern on the same line — it becomes part of the pattern and
# silently stops matching. Keep every comment on its own line.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/

# --- AICN secrets & runtime state (NEVER commit these) ---
# Ed25519 private identity keys (e.g. identity.key)
*.key
# approved-keys store (fingerprints/pubkeys)
authorized_keys.json
# per-identity reputation data
reputation.json
# TLS certificate + private key
cert.pem
key.pem
# gateway.log / agent.log
*.log
# local CLI config / identity, if kept in-tree
.aicn/

# --- Local per-node deploy configs (may contain tokens) ---
node.config.136.json
node.config.139.json

# --- Portal (web app) runtime data (NEVER commit — holds user accounts) ---
# SQLite databases (portal/portal.db: users, sessions, orgs, jobs) + side-files
*.db
*.db-wal
*.db-shm
# systemd EnvironmentFile (admin token, paths)
aicn.env

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
