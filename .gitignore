# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/

# --- AICN secrets & runtime state (NEVER commit these) ---
*.key                    # Ed25519 private identity keys (e.g. identity.key)
authorized_keys.json     # approved-keys store (fingerprints/pubkeys)
reputation.json          # per-identity reputation data
cert.pem                 # TLS certificate
key.pem                  # TLS private key
*.log                    # gateway.log / agent.log
.aicn/                   # local CLI config, if kept in-tree

# --- Local per-node deploy configs (may contain tokens) ---
# The format is documented in the README; ship node.config.nightly.json as a sample.
node.config.136.json
node.config.139.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
