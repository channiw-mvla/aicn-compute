# AICN service settings — copy to /home/wchanning/aicn/aicn.env and edit.
# Used by aicn-gateway.service (gateway box) and aicn-agent.service (node boxes).
# Keep this file private (chmod 600) — it holds the admin token.

# ---- gateway box ----
AICN_AUTHORIZED_KEYS=/home/wchanning/aicn/authorized_keys.json
AICN_REPUTATION=/home/wchanning/aicn/reputation.json
AICN_ADMIN_TOKEN=change-me-to-a-secret
AICN_AUTO_APPROVE_NODES=1
AICN_TRUSTED_PROXY=1

# ---- node boxes ----
# Use the stable named-tunnel domain once you have one; the quick-tunnel URL changes on restart.
AICN_GATEWAY=wss://gateway.YOURDOMAIN.com
AICN_NODE_ID=gpuserver-139
