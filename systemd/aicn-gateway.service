[Unit]
# AICN gateway — runs on the GATEWAY box. Reads its settings from the
# EnvironmentFile (see aicn.env.example). Adjust User/paths to your setup.
Description=AICN gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wchanning
WorkingDirectory=/home/wchanning/aicn
EnvironmentFile=/home/wchanning/aicn/aicn.env
# The gateway reads AICN_AUTHORIZED_KEYS / AICN_ADMIN_TOKEN / AICN_AUTO_APPROVE_NODES /
# AICN_TRUSTED_PROXY / AICN_REPUTATION from the environment, so the command stays short.
ExecStart=/home/wchanning/aicn/venv/bin/python gateway.py --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
