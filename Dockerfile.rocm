# Dockerfile.rocm — AICN GPU worker image for AMD RDNA4 (Radeon AI PRO R9700 / gfx1201).
#
# PyTorch on ROCm + the common AI/ML stack (numpy, pandas, scikit-learn, xgboost,
# matplotlib, opencv, transformers, timm, …). Bakes in a torch build that supports
# gfx1201 (ROCm 6.4 nightly — the combo confirmed working on the host: torch
# 2.10.0.dev + rocm6.4). Hardened GPU jobs then need NO per-job pip (the hardened
# sandbox has no network) — every dependency is already in the image.
#
# BUILD (on the AMD node, or anywhere then push to a registry the node can pull):
#     docker build -f Dockerfile.rocm -t aicn-rocm:latest .
#
# USE (web portal): set the job's "Docker image" field to  aicn-rocm:latest
#     (leave the pip field empty)
# USE (CLI):
#     aicn run train.py --image aicn-rocm:latest --gpu --ram 8g --out ./results --target gpuserver-139
#
# The hardened sandbox passes /dev/kfd + /dev/dri and the video/render groups through
# automatically for --gpu jobs; everything else stays locked down.
#
# TAG NOTE: pick a base tag that matches your host ROCm. Yours is 6.4.4, so a 6.4.x
# image is right. Check https://hub.docker.com/r/rocm/dev-ubuntu-24.04/tags and adjust
# the tag below if this one 404s.
FROM rocm/dev-ubuntu-24.04:6.4-complete

# The sandbox invokes `python` (not `python3`), and Ubuntu 24.04's system Python is
# "externally managed" — so provide a `python` symlink and allow the install.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/*

# torch (+vision/audio) nightly for ROCm 6.4 — includes the gfx1201 (RDNA4)
# kernels. Installed together from the ROCm index so the versions match.
# (Switch to the stable index once a stable rocm6.4 torch supports gfx1201.)
RUN python -m pip install --no-cache-dir --break-system-packages --pre \
      torch torchvision torchaudio \
      --index-url https://download.pytorch.org/whl/nightly/rocm6.4

# --- the common AI/ML stack, from the default index -------------------------
# IMPORTANT: these come AFTER torch and must not replace it. The ROCm build
# already satisfies their "torch" requirement, so pip leaves it alone — the
# assertion at the end of this file verifies that it really did.
RUN python -m pip install --no-cache-dir --break-system-packages \
      numpy pandas scipy \
      scikit-learn statsmodels \
      matplotlib seaborn

RUN python -m pip install --no-cache-dir --break-system-packages \
      xgboost lightgbm joblib

RUN python -m pip install --no-cache-dir --break-system-packages \
      pillow opencv-python-headless \
      transformers tokenizers datasets accelerate safetensors einops timm \
      requests tqdm pyyaml h5py

# The container runs read-only, as an unprivileged user, with only /tmp writable.
# Point HOME and every library cache at /tmp, or matplotlib/HF/MIOpen will crash
# trying to write to $HOME. HF_HUB_OFFLINE because the sandbox has no network —
# fail fast instead of hanging on a download that can never succeed.
ENV HOME=/tmp \
    MIOPEN_USER_DB_PATH=/tmp/miopen \
    MIOPEN_CUSTOM_CACHE_DIR=/tmp/miopen \
    MPLCONFIGDIR=/tmp/mpl \
    HF_HOME=/tmp/hf \
    TRANSFORMERS_CACHE=/tmp/hf \
    XDG_CACHE_HOME=/tmp/cache \
    TORCH_HOME=/tmp/torch \
    HF_HUB_OFFLINE=1 \
    PYTHONUNBUFFERED=1

# Fail the build if the interpreter is wrong, a library is missing, or — the one
# that really matters — if installing the extras above quietly swapped the ROCm
# torch for a CPU-only build from PyPI.
RUN python -c "\
import torch, torchvision, numpy, pandas, sklearn, scipy, matplotlib, seaborn, \
       xgboost, lightgbm, PIL, cv2, transformers, timm, statsmodels; \
assert torch.version.hip, 'ROCm torch was replaced by a CPU build — reorder the installs'; \
print('torch', torch.__version__, '| hip', torch.version.hip); \
print('torchvision', torchvision.__version__, '| numpy', numpy.__version__); \
print('transformers', transformers.__version__, '| sklearn', sklearn.__version__)"

# ---------------------------------------------------------------------------
# SMALLER ALTERNATIVE (optional): the rocm/dev '-complete' base is ~30 GB. Because
# the torch ROCm wheel bundles its own userspace ROCm libraries, a slim base often
# works too (kernel access comes from the passed-through /dev/kfd). If image size
# matters, try replacing the FROM line above with:
#     FROM ubuntu:24.04
# keep the same apt + pip steps, and test one GPU job before relying on it.
# ---------------------------------------------------------------------------
